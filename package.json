    "validate": "node scripts/validate.cjs",
    "check": "npm test && npm run validate"
  },
  "devDependencies": {
    "yaml": "2.9.1",
    "@playwright/test": "1.65.0",
    "@axe-core/playwright": "4.14.0"
  }
}
