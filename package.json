{
  "name": "imagecraft",
  "version": "0.5.0",
  "private": true,
  "description": "An approachable RHEL image mode guide and recipe workbench",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
